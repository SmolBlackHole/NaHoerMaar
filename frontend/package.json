{
	"name": "nahormaar-frontend",
	"version": "0.1.0",
	"description": "Web dashboard for controlling the private NaHörMaar Discord music bot.",
	"private": true,
	"type": "module",
	"license": "MPL-2.0",
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"predev": "node ../scripts/licenses.mjs",
		"dev": "nuxt dev --host 127.0.0.1 --port 3012 --dotenv ../.env",
		"prebuild": "node ../scripts/licenses.mjs",
		"build": "nuxt build",
		"preview": "nuxt preview --host 127.0.0.1",
		"postinstall": "nuxt prepare",
		"typecheck": "nuxt typecheck",
		"check": "npm run test && npm run typecheck && npm run build",
		"test": "vitest run"
	},
	"dependencies": {
		"@iconify-json/heroicons": "^1.2.3",
		"@iconify-json/lucide": "^1.2.130",
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/tabler": "^1.2.38",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/ui": "^4.11.1",
		"@pinia/nuxt": "^0.11.3",
		"@vueuse/core": "^14.4.0",
		"@vueuse/nuxt": "^14.4.0",
		"h3": "^1.15.11",
		"nuxt": "^4.5.2",
		"pinia": "^3.0.4",
		"reka-ui": "2.10.4",
		"sortablejs": "^1.15.7",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.42",
		"vue-router": "^5.3.1"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/sortablejs": "^1.15.9",
		"typescript": "~5.9.3",
		"vitest": "^5.0.0",
		"vue-tsc": "~3.2.9"
	}
}
