DISCORD_TOKEN=
POSTGRES_DB=nahormaar
POSTGRES_USER=nahormaar
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nahormaar:replace-with-a-long-random-secret@127.0.0.1:5432/nahormaar
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated extra browser origins. Nuxt development uses port 3001;
# add temporary HTTPS tunnel origins here when needed.
ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO
NAHORMAAR_LOG_DIR=data/logs
NAHORMAAR_AVATAR_DIR=data/avatars
LOG_RETENTION_DAYS=14
STATISTICS_TIMEZONE=Europe/Berlin
# Pause, checkpoint and leave after this many seconds without human listeners.
EMPTY_CHANNEL_GRACE_SECONDS=60
# Register the callback for PUBLIC_ORIGIN and every OAuth origin in ALLOWED_ORIGINS
# Host port for the Docker Compose dashboard
NAHORMAAR_PORT=3000
# Optional: only change this when the backend listens on an internal container network
# NAHORMAAR_BIND_HOST=127.0.0.1
# ACCESS_PATH=config/access.toml
# Optional: overrides the FFmpeg binary installed with the Python dependencies
# FFMPEG_PATH=
# Optional: use a Node.js executable outside PATH
# NODE_PATH=
